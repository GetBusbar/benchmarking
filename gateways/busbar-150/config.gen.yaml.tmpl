# busbar 1.5.0 config.
#
# PRODUCED BY BUSBAR'S OWN MIGRATOR, not hand-written: `busbar --migrate-config` run against the
# 1.4.1 config this board publishes. 1.5.0 refuses a 1.x config outright rather than booting it
# under new semantics ("allowed_pools: [] now means NO pools"), so the two versions cannot share one
# file and "identical config, only the binary differs" was never available here.
#
# The migration is the whole diff, and it is mechanical: six providers moved from the flat
# api_key_env form to the nested api_key/env form. No limit, pool, or routing surface changed, and `busbar --validate` accepts
# the result (6 providers, 6 models). providers.gen.yaml.tmpl needs NO migration - the 1.4.1 shape
# validates unchanged under 1.5.0 - so it is byte-identical to the 1.4.1 manifest's.
#
# max_concurrent: 8000 is CARRIED OVER, matching 1.4.1 exactly. The v1.5.0 source types it
# Option<usize>, but the published image still requires it, and keeping the same value is what makes
# the two rows comparable on the axis that matters.

listen: 127.0.0.1:{GW_PORT}
providers:
  mock-openai:
    api_key:
      env: BENCH_MOCK_KEY
  mock-responses:
    api_key:
      env: BENCH_MOCK_KEY
  mock-anthropic:
    api_key:
      env: BENCH_MOCK_KEY
  mock-gemini:
    api_key:
      env: BENCH_MOCK_KEY
  mock-cohere:
    api_key:
      env: BENCH_MOCK_KEY
  mock-bedrock:
    api_key:
      env: BENCH_BEDROCK_KEY
models:
  gpt-4o-mini:
    provider: mock-openai
    max_concurrent: 8000
  gpt-4o-mini-responses:
    provider: mock-responses
    max_concurrent: 8000
  gpt-4o-mini-anthropic:
    provider: mock-anthropic
    max_concurrent: 8000
  gpt-4o-mini-gemini:
    provider: mock-gemini
    max_concurrent: 8000
  gpt-4o-mini-cohere:
    provider: mock-cohere
    max_concurrent: 8000
  gpt-4o-mini-bedrock:
    provider: mock-bedrock
    max_concurrent: 8000

# AUTH OFF, TO MATCH WHAT 1.4.1 ACTUALLY RAN.
#
# The 1.4.1 config on this board has no auth block at all, and 1.4.1 permitted that. 1.5.0 refuses to
# boot silently in that state - it hardened - so the posture has to be declared rather than implied.
# `chain: []` is busbar's own documented dev setting ("the open front door: development only, loud
# startup warning"), and it is the ONLY setting that keeps the two rows comparable: with a real auth
# chain, 1.5.0 would verify a signed key on every request while 1.4.1 verified nothing, and the delta
# would be measuring authentication rather than the gateway.
#
# It is not a favour to 1.5.0 either - busbar logs an ERROR and two WARNs about it on every boot, and
# the board's rule is the bare minimum required to run.
auth:
  chain: []
