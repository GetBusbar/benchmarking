listen: "127.0.0.1:{GW_PORT}"
providers:
  mock-openai:
    api_key_env: BENCH_MOCK_KEY
  mock-responses:
    api_key_env: BENCH_MOCK_KEY
  mock-anthropic:
    api_key_env: BENCH_MOCK_KEY
  mock-gemini:
    api_key_env: BENCH_MOCK_KEY
  mock-cohere:
    api_key_env: BENCH_MOCK_KEY
  mock-bedrock:
    api_key_env: BENCH_BEDROCK_KEY
models:
  gpt-4o-mini:
    # OOTB canonical (OpenAI) lane — the perf/memory/throughput default. IDENTICAL to the 1.4.1
    # manifest, deliberately: the two versions are compared on the same config so the only thing
    # differing between the rows is the binary.
    #
    # max_concurrent stays. The v1.5.0 SOURCE TAG makes it `Option<usize>`, and I removed it on that
    # basis - the released image then refused to boot: "models.gpt-4o-mini: missing field
    # `max_concurrent`". The published image (Docker Hub 05:29 UTC) predates the v1.5.0 tag (05:54
    # UTC) by 25 minutes, so it is not built from that source. The artifact a user pulls is what this
    # board measures, and it requires the field.
    #
    # 8000 sits above the sweep's winning band so it is a ceiling, not the limiter.
    # max_requests: -1 = unmetered.
    provider: mock-openai
    max_concurrent: 8000
  gpt-4o-mini-responses:
    provider: mock-responses
    max_concurrent: 8000
  gpt-4o-mini-anthropic:
    provider: mock-anthropic
    max_concurrent: 8000
  gpt-4o-mini-gemini:
    provider: mock-gemini
    max_concurrent: 8000
  gpt-4o-mini-cohere:
    provider: mock-cohere
    max_concurrent: 8000
  gpt-4o-mini-bedrock:
    provider: mock-bedrock
    max_concurrent: 8000
