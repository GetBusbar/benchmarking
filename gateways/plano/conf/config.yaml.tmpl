# Plano model listener; provider prefixes choose adapters, not necessarily native wire formats.
# Gemini uses its OpenAI-compatible endpoint here, allowing explicit Chat-only upstream selection.
# The separate OpenAI model selects native Responses for Responses ingress.
version: v0.3.0

listeners:
  - name: llm
    type: model
    port: {GW_PORT}

model_providers:
  - model: openai/gpt-4o-mini
    base_url: 'http://127.0.0.1:{MOCK_PORT}'
    access_key: {GW_AUTH}
    default: true

  - model: anthropic/claude-3-5-sonnet
    base_url: 'http://127.0.0.1:{MOCK_PORT}'
    access_key: {GW_AUTH}

  - model: gemini/gemini-1.5-pro
    base_url: 'http://127.0.0.1:{MOCK_PORT}'
    access_key: {GW_AUTH}

  - model: amazon_bedrock/anthropic.claude-3-sonnet-20240229-v1:0
    base_url: http://127.0.0.1:{MOCK_PORT}
    access_key: {GW_AUTH}

tracing:
  random_sampling: 0
