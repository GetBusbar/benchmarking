{
  "auth": "sk-dummy",
  "cell_paths": {
    "anthropic>openai-responses": "/anthropic/v1/messages"
  },
  "class": "LLM gateway",
  "config": [],
  "config_files": [
    {
      "output": "bfdata/config.json",
      "template": "bfdata/config.json.tmpl"
    }
  ],
  "display": "Bifrost",
  "egress": [
    "openai",
    "openai-responses",
    "anthropic",
    "gemini",
    "cohere"
  ],
  "egress_models": {
    "anthropic": "claude-3-5-sonnet-20241022",
    "cohere": "command-r-plus",
    "gemini": "gemini-1.5-pro",
    "openai": "gpt-4o-mini",
    "openai-responses": "gpt-4o-mini"
  },
  "lang": "Go",
  "launch": {
    "args": [],
    "image": "maximhq/bifrost:v1.6.4",
    "kind": "docker",
    "mounts": [
      {
        "container_path": "/app/data",
        "host_path": "bfdata",
        "read_only": false
      }
    ]
  },
  "matrix": [
    "101110",
    "010000",
    "010000",
    "000000",
    "000000",
    "000000"
  ],
  "matrix_note": "Bifrost v1.6.4 has no openai-chat -> responses bridge and no gemini/cohere/bedrock-format ingress; undeclared cells are grey by that capability limit",
  "model": "gpt-4o-mini",
  "name": "bifrost",
  "path": "/v1/chat/completions",
  "port": 8080,
  "repo": "https://github.com/maximhq/bifrost",
  "runtime": {
    "container": "bifrost",
    "kind": "docker"
  },
  "untestable": [
    "openai/bedrock"
  ],
  "untestable_note": "Bifrost v1.6.4 hardcodes the Bedrock host (bedrock-runtime.<region>.amazonaws.com, core/providers/bedrock/bedrock.go; network_config.base_url never overrides it), so the harness mock cannot stand in for the upstream; Bifrost does serve Bedrock Converse in production"
}
