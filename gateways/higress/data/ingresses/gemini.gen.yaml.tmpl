apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gemini
  namespace: higress-system
  annotations:
    higress.io/destination: mock.static
spec:
  rules:
  - host: gemini.bench
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          resource:
            apiGroup: networking.higress.io
            kind: McpBridge
            name: default
