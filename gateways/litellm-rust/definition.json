{
  "auth": "gwbench",
  "class": "LLM gateway",
  "config": [],
  "config_files": [
    {
      "output": "config.gen.yaml",
      "template": "config.gen.yaml.tmpl"
    }
  ],
  "display": "LiteLLM \u00b7 Rust",
  "egress": [
    "anthropic"
  ],
  "headers": [
    "Authorization: Bearer {GW_AUTH}"
  ],
  "lang": "Rust",
  "launch": {
    "args": [],
    "binary": [
      "src/litellm-rust/target/release/litellm-ai-gateway",
      "src/litellm-rust/target/release/litellm_ai_gateway",
      "src/litellm-rust/target/release/server"
    ],
    "build": "build.sh",
    "kind": "native"
  },
  "matrix": [
    "000000",
    "000000",
    "001000",
    "000000",
    "000000",
    "000000"
  ],
  "matrix_note": "LiteLLM-Rust beta serves only the Anthropic /v1/messages route (azure_ai upstream); no other ingress or upstream dialect exists, so those cells are grey by that capability limit",
  "model": "azure_ai/mock",
  "name": "litellm-rust",
  "path": "/v1/messages",
  "port": 8101,
  "repo": "https://github.com/BerriAI/litellm",
  "runtime": {
    "kind": "native",
    "proc_match": "litellm-ai-gateway"
  }
}
