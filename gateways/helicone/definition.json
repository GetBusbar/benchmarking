{
  "auth": "dummy",
  "cell_paths": {
    "anthropic>anthropic": "/anthropic/v1/messages",
    "bedrock>bedrock": "/bedrock/model/anthropic.claude-3-5-sonnet-v1:0/converse",
    "openai>anthropic": "/router/anthropic/chat/completions",
    "openai>bedrock": "/router/bedrock/chat/completions",
    "openai>openai": "/router/openai/chat/completions"
  },
  "class": "AI gateway",
  "config": [],
  "config_files": [
    {
      "output": "config.gen.yaml",
      "template": "config.gen.yaml.tmpl"
    }
  ],
  "display": "Helicone",
  "egress": [
    "openai",
    "anthropic",
    "bedrock"
  ],
  "egress_models": {
    "anthropic": "anthropic/claude-3-5-sonnet",
    "bedrock": "bedrock/anthropic.claude-3-5-sonnet-v1:0",
    "openai": "openai/gpt-4o-mini"
  },
  "lang": "Rust",
  "launch": {
    "args": [
      "-c",
      "{GW_DIR}/config.gen.yaml"
    ],
    "binary": [
      "src/target/release/ai-gateway"
    ],
    "build": "build.sh",
    "kind": "native"
  },
  "model": "openai/gpt-4o-mini",
  "name": "helicone",
  "path": "/router/openai/chat/completions",
  "port": 8787,
  "repo": "https://github.com/Helicone/ai-gateway",
  "runtime": {
    "kind": "native",
    "proc_match": "target/release/ai-gateway"
  }
}
