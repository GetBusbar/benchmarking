{
  "auth": "dummy",
  "class": "Model gateway",
  "config": [],
  "config_files": [
    {
      "output": "config/tensorzero.toml",
      "template": "config/tensorzero.toml.tmpl"
    }
  ],
  "display": "TensorZero",
  "egress": [
    "openai",
    "openai-responses",
    "anthropic",
    "bedrock"
  ],
  "lang": "Rust",
  "launch": {
    "args": [
      "--config-file",
      "config/tensorzero.toml"
    ],
    "image": "tensorzero/gateway:2026.6.0",
    "kind": "docker",
    "mounts": [
      {
        "container_path": "/app/config",
        "host_path": "config",
        "read_only": true
      }
    ]
  },
  "matrix": [
    "111001",
    "000000",
    "000000",
    "000000",
    "000000",
    "000000"
  ],
  "matrix_note": "TensorZero 2026.6.0 has no Cohere provider type; that cell is grey by that capability limit (model.rs)",
  "model": "tensorzero::model_name::mock-openai",
  "name": "tensorzero",
  "path": "/openai/v1/chat/completions",
  "port": 3000,
  "repo": "https://github.com/tensorzero/tensorzero",
  "runtime": {
    "container": "tensorzero-bench",
    "kind": "docker"
  },
  "untestable": [
    "openai/gemini"
  ],
  "untestable_note": "TensorZero's google_ai_studio_gemini / gcp_vertex_gemini providers hardcode googleapis.com with no api_base override (google_ai_studio_gemini.rs @2026.6.0), so the harness mock cannot stand in for the upstream; TensorZero does serve Gemini in production"
}
