{
  "auth": "bench-token",
  "class": "AI gateway",
  "config": [],
  "config_files": [
    {
      "output": "config.gen.yaml",
      "template": "config.gen.yaml.tmpl"
    },
    {
      "output": "resources.gen.yaml",
      "template": "resources.gen.yaml.tmpl"
    }
  ],
  "constants": {
    "GW_MODEL_ANTHROPIC": "claude-3-5-sonnet-20241022",
    "GW_MODEL_OPENAI": "gpt-4o-mini"
  },
  "display": "AISIX (api7)",
  "egress": [
    "openai",
    "openai-responses",
    "anthropic"
  ],
  "egress_models": {
    "anthropic": "claude-3-5-sonnet-20241022",
    "openai": "gpt-4o-mini",
    "openai-responses": "gpt-4o-mini"
  },
  "lang": "Rust",
  "launch": {
    "kind": "docker",
    "image": "ghcr.io/api7/aisix:1.9.0@sha256:dbe230bdaa4f353f7bf99d5437ab11f8b67435afabb217cf371c441ede43270a",
    "args": [
      "--config",
      "/etc/aisix/config.yaml"
    ],
    "mounts": [
      {
        "host_path": "config.gen.yaml",
        "container_path": "/etc/aisix/config.yaml",
        "read_only": true
      },
      {
        "host_path": "resources.gen.yaml",
        "container_path": "/etc/aisix/resources.yaml",
        "read_only": true
      }
    ]
  },
  "model": "gpt-4o-mini",
  "name": "aisix",
  "path": "/v1/chat/completions",
  "port": 3000,
  "repo": "https://github.com/api7/aisix",
  "runtime": {
    "kind": "docker",
    "container": "aisix-bench"
  }
}
