{
  "auth": "sk-fake-benchmark-key",
  "class": "API gateway",
  "config": [],
  "config_files": [
    {
      "output": "config.gen.yaml",
      "template": "config.gen.yaml.tmpl"
    },
    {
      "output": "apisix.gen.yaml",
      "template": "apisix.gen.yaml.tmpl"
    }
  ],
  "constants": {
    "APISIX_BEDROCK_MODEL": "anthropic.claude-3-sonnet-20240229-v1:0",
    "GW_MATRIX_PATH_BEDROCK": "/model/{APISIX_BEDROCK_MODEL}/converse",
    "ncore": "{NCORE}"
  },
  "display": "APISIX",
  "egress": [
    "openai",
    "openai-responses",
    "anthropic",
    "bedrock"
  ],
  "lang": "Other",
  "launch": {
    "args": [],
    "image": "apache/apisix:3.17.0-debian",
    "kind": "docker",
    "mounts": [
      {
        "container_path": "/usr/local/apisix/conf/config.yaml",
        "host_path": "config.gen.yaml",
        "read_only": true
      },
      {
        "container_path": "/usr/local/apisix/conf/apisix.yaml",
        "host_path": "apisix.gen.yaml",
        "read_only": true
      }
    ]
  },
  "matrix": [
    "100000",
    "010000",
    "001000",
    "000000",
    "000000",
    "000001"
  ],
  "matrix_note": "APISIX 3.17.0 ai-proxy has no native Gemini generateContent or Cohere provider, and no OpenAI-to-Anthropic/Bedrock converter; its one anthropic->openai converter is not offered either, because ai-proxy binds one provider per route URI and the single /v1/messages URI is bound to the anthropic provider (the anthropic>anthropic diagonal) - serving both would need a per-column config rewrite, which the one-static-config standard forbids. Other cells are grey by that capability limit (ai-proxy/base.lua, ai-protocols/converters/init.lua)",
  "model": "gpt-4o-mini",
  "name": "apisix",
  "path": "/v1/chat/completions",
  "port": 9080,
  "repo": "https://github.com/apache/apisix",
  "runtime": {
    "container": "apisix-bench",
    "kind": "docker"
  }
}
