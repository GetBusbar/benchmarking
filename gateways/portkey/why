# Why every setting, env var, header and command this gateway uses is here.
#
# The rule, from the published methodology: a setting may appear only if it is needed to boot the
# process at all, to point an upstream at the test mock instead of a real provider, to expose an
# ingress path the matrix exercises, or to bind the port and cores the rig requires. One claim per
# line: <pattern> <boot|upstream|ingress|bind>. Nothing machine-checks this file: the shell lint
# that read these claims was deleted in 1127cf1, so it is a reviewed disclosure kept in step with
# the config by hand.
#
# Migrated from GW_CONFIG_WHY in the shell-era gateway.sh (deleted in 1127cf1).
x-portkey-provider    upstream  # which upstream dialect this column egresses in
x-portkey-custom-host upstream  # -> the mock, instead of the real provider host
x-portkey-aws-access-key-id     boot  # bedrock SigV4 material; without it the request is refused
x-portkey-aws-secret-access-key boot  # before any egress (dummy; the mock ignores the signature)
x-portkey-aws-region            boot
