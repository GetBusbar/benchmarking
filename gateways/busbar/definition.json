{
  "auth": "bench-token",
  "class": "Control plane",
  "config": [],
  "config_files": [
    {
      "output": "providers.gen.yaml",
      "template": "providers.gen.yaml.tmpl"
    },
    {
      "output": "config.gen.yaml",
      "template": "config.gen.yaml.tmpl"
    }
  ],
  "display": "Busbar",
  "egress": [
    "openai",
    "openai-responses",
    "anthropic",
    "gemini",
    "cohere",
    "bedrock"
  ],
  "lang": "Rust",
  "launch": {
    "args": [],
    "image": "getbusbar/busbar:1.4.1",
    "kind": "docker",
    "mounts": [
      {
        "container_path": "/etc/busbar/config.yaml",
        "host_path": "config.gen.yaml",
        "read_only": true
      },
      {
        "container_path": "/etc/busbar/providers.yaml",
        "host_path": "providers.gen.yaml",
        "read_only": true
      }
    ]
  },
  "model": "gpt-4o-mini",
  "name": "busbar",
  "path": "/v1/chat/completions",
  "port": 8080,
  "repo": "https://github.com/GetBusbar/busbar",
  "runtime": {
    "container": "busbar-bench",
    "kind": "docker"
  }
}
