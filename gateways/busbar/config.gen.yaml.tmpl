listen: "127.0.0.1:{GW_PORT}"
providers:
  mock-openai:
    api_key: {{ env: BENCH_MOCK_KEY }}
  mock-responses:
    api_key: {{ env: BENCH_MOCK_KEY }}
  mock-anthropic:
    api_key: {{ env: BENCH_MOCK_KEY }}
  mock-gemini:
    api_key: {{ env: BENCH_MOCK_KEY }}
  mock-cohere:
    api_key: {{ env: BENCH_MOCK_KEY }}
  mock-bedrock:
    api_key: {{ env: BENCH_BEDROCK_KEY }}
models:
  gpt-4o-mini:
    # OOTB canonical (OpenAI) lane — the perf/memory/throughput default. max_concurrent is OPTIONAL
    # since v1.5.0 (unset = unbounded); 8000 sits above the sweep's winning band so it is an explicit
    # ceiling, not the limiter — the forced-name equivalent of an unbounded default, not a tuned
    # advantage. max_requests: -1 = unmetered.
    provider: mock-openai
    max_concurrent: 8000
  gpt-4o-mini-responses:
    provider: mock-responses
    max_concurrent: 8000
  gpt-4o-mini-anthropic:
    provider: mock-anthropic
    max_concurrent: 8000
  gpt-4o-mini-gemini:
    provider: mock-gemini
    max_concurrent: 8000
  gpt-4o-mini-cohere:
    provider: mock-cohere
    max_concurrent: 8000
  gpt-4o-mini-bedrock:
    provider: mock-bedrock
    max_concurrent: 8000
