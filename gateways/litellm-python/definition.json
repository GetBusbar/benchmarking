{
  "auth": "dummy",
  "class": "LLM gateway",
  "config": [],
  "config_files": [
    {
      "output": "config.gen.yaml",
      "template": "config.gen.yaml.tmpl"
    }
  ],
  "display": "LiteLLM \u00b7 Python",
  "egress": [
    "openai",
    "openai-responses",
    "anthropic",
    "gemini",
    "cohere",
    "bedrock"
  ],
  "egress_models": {
    "anthropic": "gpt-4o-mini-anthropic",
    "bedrock": "gpt-4o-mini-bedrock",
    "cohere": "gpt-4o-mini-cohere",
    "gemini": "gpt-4o-mini-gemini",
    "openai": "gpt-4o-mini",
    "openai-responses": "gpt-4o-mini-responses"
  },
  "lang": "Python",
  "launch": {
    "args": [
      "--config",
      "/config.gen.yaml",
      "--port",
      "{GW_PORT}"
    ],
    "image": "ghcr.io/berriai/litellm:v1.93.0",
    "kind": "docker",
    "mounts": [
      {
        "container_path": "/config.gen.yaml",
        "host_path": "config.gen.yaml",
        "read_only": true
      }
    ]
  },
  "matrix": [
    "111111",
    "010000",
    "001000",
    "000000",
    "000000",
    "000000"
  ],
  "matrix_note": "LiteLLM accepts OpenAI ingress into any provider plus native Anthropic/Responses ingress diagonals; other ingress rows are grey by declaration",
  "model": "gpt-4o-mini",
  "name": "litellm-python",
  "path": "/v1/chat/completions",
  "port": 8102,
  "repo": "https://github.com/BerriAI/litellm",
  "runtime": {
    "container": "litellm-python-bench",
    "kind": "docker"
  }
}
